{
  "name": "genesis-portal-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "npm run validate:pj0550-snapshot && npm run validate:pj0550-data && npm run validate:pj0550-coverage && npm run validate:pj0550-evidence && npm run validate:pj0550-bidding && webpack --mode production",
    "validate:pj0550-bidding": "node scripts/validate-pj2608-0550-bidding.cjs",
    "validate:pj0550-snapshot": "node scripts/validate-pj2608-0550-snapshot.cjs",
    "validate:pj0550-evidence": "node scripts/validate-pj2608-0550-evidence.cjs",
    "validate:pj0550-coverage": "node scripts/validate-pj2608-0550-coverage.cjs",
    "validate:pj0550-data": "node scripts/validate-pj2608-0550-data.cjs"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.0.0",
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "babel-loader": "^9.0.0"
  }
}
